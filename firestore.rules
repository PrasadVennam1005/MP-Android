rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{email} {
      allow read, write: if isAuthenticated();
    }

    // CoSplit Groups Collection
    match /cosplit_groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        (request.auth.token.email in resource.data.members) || 
        (request.auth.token.email in request.resource.data.members && 
         request.resource.data.members.size() == resource.data.members.size() + 1 &&
         request.resource.data.balances[request.auth.token.email] == 0.0)
      );
      allow delete: if isAuthenticated() && resource.data.createdById == request.auth.uid;

      // Expenses Subcollection
      match /expenses/{expenseId} {
        allow read, write: if isAuthenticated() && (request.auth.token.email in get(/databases/$(database)/documents/cosplit_groups/$(groupId)).data.members);
      }
    }
  }
}
